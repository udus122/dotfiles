#!/usr/bin/env bash
# マージ済みの worktree を削除する。
#
#   git wt-clean [--dry-run] [リポジトリパス...]
#
# 対象は「デフォルトブランチに取り込み済み」かつ「未コミット変更なし」の worktree。
# 取り込み済みかどうかは、ブランチが付いていれば --merged、detached HEAD なら
# その commit がデフォルトブランチの祖先かどうかで判定する。
# detached HEAD の worktree も走査すること。ブランチ名でしか列挙しないと、
# 消しても失うもののない複製が一覧にすら現れず、無期限に積み上がる。
# 未コミット変更があるものはスキップして一覧に出す。
# 取り込み済みでないものは消さないが、これも一覧に出す。黙って飛ばすと、
# worktree が 1 つも無いリポジトリと出力が同じになり、二度と取り込まれない
# 複製がそこに在ること自体が分からなくなる。
# 未取り込みのものには、どのリモートにも無いコミットの件数と、未コミット変更の
# 件数を添える。「取り込まれていない」だけでは、リモートに控えがあるものと、
# この機械が唯一の複製であるものが同じ行に見える。後者を消すと復元できない。
# 未コミット変更はコミットより先に唯一の複製になるので、未 push が 0 件でも添える。
# 無視されたファイルを抱えている worktree は、その件数を添えて出す（消える対象なので）。
# リポジトリ配下に切られたものには [リポジトリ配下] を添える。置き場のルールから
# 外れているうえ、gitignore を尊重しない検索が本体と複製の両方に当たる。
# リポジトリパスを省略すると、カレントリポジトリを対象にする。
# 渡すのは本体のチェックアウトでも linked worktree でもよい。どちらを渡しても
# そのリポジトリ全体を対象にする。worktree の置き場をまとめて渡せるようにするため
# （`git wt-clean --dry-run ~/ws/worktrees/*/*`）。同じリポジトリが重なったぶんは畳む。
set -uo pipefail

DRY_RUN=0
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN=1
    shift
fi

repos=("$@")
if [[ ${#repos[@]} -eq 0 ]]; then
    repos=("$(git rev-parse --show-toplevel)") || exit 1
fi

total_removed=0
total_skipped=0
total_kept=0

seen=()

for repo in "${repos[@]}"; do
    # 渡されたパスは本体のチェックアウトとは限らない。worktree の置き場を
    # まとめて渡す使い方（`git wt-clean ~/ws/worktrees/*/*`）では、渡るのは
    # すべて linked worktree になる。--show-toplevel はそこで渡された
    # worktree 自身を返すので、本体を root と取り違える。すると本体が
    # worktree の一覧に紛れ、削除対象として名指しされる一方、確かめたかった
    # worktree のほうは root と同一視されて走査から落ちる。
    # worktree list の先頭は常に本体なので、そこから root を決める。
    # パスに空白を含みうるので $2 では切らない。
    root=$(git -C "$repo" worktree list --porcelain 2>/dev/null |
        awk '/^worktree /{ sub(/^worktree /, ""); print; exit }')
    if [[ -z "$root" ]]; then
        echo "skip (git リポジトリではない): $repo"
        continue
    fi

    # 同じリポジトリの worktree が複数渡ると、同じ root を何度も走査する。
    # 出力が重なるだけでなく、末尾の件数が渡した数だけ倍になり、
    # 消える worktree が実際より多いように見える。
    dup=0
    for s in ${seen+"${seen[@]}"}; do
        [[ "$s" == "$root" ]] && { dup=1; break; }
    done
    [[ $dup -eq 1 ]] && continue
    seen+=("$root")

    echo
    echo "### $root"
    git -C "$root" fetch --prune origin >/dev/null 2>&1

    default=$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    default=${default:-origin/main}

    merged=$(git -C "$root" branch --merged "$default" --format='%(refname:short)' 2>/dev/null)

    while IFS=$'\t' read -r path head branch; do
        [[ "$path" == "$root" ]] && continue

        # リポジトリ配下に切られた worktree は置き場のルールから外れている。
        # 実害は検索で、gitignore を尊重しない経路（grep -r など）が本体と複製の
        # 両方に当たる。git status にも ls-files にも現れないので、ここで名指ししないと
        # 在ること自体に気付く経路が無い。消せないもの（未取り込み・未コミット変更）にも
        # 付ける。積み上がって検索を汚し続けるのはむしろそちらのため。
        place=""
        case "$path" in
            "$root"/*) place="  [リポジトリ配下]" ;;
        esac

        if [[ "$branch" == "-" ]]; then
            label="(detached ${head:0:7})"
            git -C "$root" merge-base --is-ancestor "$head" "$default" 2>/dev/null
            taken=$?
        else
            label="$branch"
            grep -qxF "$branch" <<<"$merged"
            taken=$?
        fi

        # 未コミット変更は取り込みの判定より先に数える。未取り込みの行にも
        # 要るため。コミットされていない変更はどのリモートにも無く、この機械が
        # 唯一の複製になる。未 push の件数だけを添えて未コミット変更を伏せると、
        # 控えのある worktree と同じ行に見え、消したときだけ失われる。
        # 語は SKIP 行と揃える。出力を語で絞り込むと、揃っていない側が落ちる。
        # ここでは --ignored を付けない。無視されたファイルの件数が要るのは
        # 削除の対象になったときだけで、走査は依存ディレクトリまで降りて重い。
        dirty=$(git -C "$path" status --porcelain 2>/dev/null | grep -c '^')

        if [[ $taken -ne 0 ]]; then
            # どのリモートからも辿れないコミットの数。0 なら控えがあるので、
            # worktree を消しても内容は remote から取り戻せる。
            # 数えられなかったことを 0 に読み替えない。但し書きの無い行は
            # 「控えがある」と読まれるので、分からないまま安全側に見せると、
            # 唯一の複製を消させることになる。
            # 但し書きを継ぎ足すときは ${keep} と括ること。bash 3.2 は
            # "$keep・" の `・` を変数名の一部として読み、未定義として落ちる。
            keep="未取り込み"
            if unpushed=$(git -C "$root" rev-list --count "$head" --not --remotes 2>/dev/null); then
                [[ "$unpushed" != "0" ]] && keep="${keep}・未 push ${unpushed}件"
            else
                keep="${keep}・未 push 件数不明"
            fi
            [[ "$dirty" != "0" ]] && keep="${keep}・未コミット変更 ${dirty}件"
            echo "KEEP ($keep): $label  $path$place"
            total_kept=$((total_kept + 1))
            continue
        fi

        if [[ "$dirty" != "0" ]]; then
            echo "SKIP (未コミット変更 ${dirty}件): $label  $path$place"
            total_skipped=$((total_skipped + 1))
            continue
        fi

        # 無視されたファイルは status に出ないが、worktree remove では一緒に消える。
        # git から復元できないローカルの作業状態（ビルド成果物、ローカル DB、依存）が
        # そこに入っているので、消える件数を出して人間が止められるようにする。
        # 削除の対象がここまで絞られてから数える。
        ignored=$(git -C "$path" status --porcelain --ignored 2>/dev/null | grep -c '^!! ')

        note=""
        [[ "$ignored" != "0" ]] && note="  (無視されたファイル ${ignored}件も消える)"

        if [[ $DRY_RUN -eq 1 ]]; then
            echo "would remove: $label  $path$place$note"
        elif git -C "$root" worktree remove --force "$path" 2>/dev/null; then
            echo "removed: $label  $path$place$note"
        else
            echo "FAILED : $label  $path$place"
            continue
        fi
        total_removed=$((total_removed + 1))
    done < <(git -C "$root" worktree list --porcelain |
        # 行の頭を削って残り全部を取る。$2 で切ると、空白を含むパスが最初の空白で
        # 千切れる。千切れたパスは worktree remove に渡しても当たらないので、
        # 空白入りの worktree は永久に片付かないまま「削除対象」として数えられる。
        # さらに本体のパスに空白があると、$root（sub で正しく取っている）と
        # 一致しなくなり、本体が linked worktree に化けて削除対象に名指しされる。
        awk '
            /^worktree /            { p = $0; sub(/^worktree /, "", p); h = ""; b = "-" }
            /^HEAD /                { h = $0; sub(/^HEAD /, "", h) }
            /^branch /              { b = $0; sub(/^branch refs\/heads\//, "", b) }
            /^$/                    { if (p != "" && h != "") print p"\t"h"\t"b; p = ""; h = ""; b = "-" }
            END                     { if (p != "" && h != "") print p"\t"h"\t"b }')

    [[ $DRY_RUN -eq 0 ]] && git -C "$root" worktree prune
done

echo
if [[ $DRY_RUN -eq 1 ]]; then
    echo "dry-run: ${total_removed}件が削除対象 / ${total_skipped}件はスキップ / ${total_kept}件は未取り込み"
else
    echo "removed=${total_removed} skipped=${total_skipped} kept=${total_kept}"
fi
